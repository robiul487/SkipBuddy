    <string name="wizard_step_notifications_title">नोटिफिकेशन की अनुमति दें</string>
    <string name="wizard_step_notifications_body">फोन रीस्टार्ट होने पर सर्विस बंद हो तो आपको याद दिलाता है।</string>
    <string name="wizard_step_autostart_title">Xiaomi और Samsung ऑटोस्टार्ट गाइड</string>
    <string name="wizard_step_autostart_xiaomi">Xiaomi / Redmi / POCO (MIUI / HyperOS):\nApp Info खोलें → Autostart चालू करें → Battery saver → \"No restrictions\" चुनें।</string>
    <string name="wizard_step_autostart_samsung">Samsung (One UI):\nApp Info खोलें → Battery → \"Unrestricted\" चुनें → Settings → Battery → Background usage limits → \"Never auto sleeping apps\" में SkipBuddy जोड़ें।</string>
    <string name="wizard_open_app_info">ऐप सेटिंग्स खोलें</string>
