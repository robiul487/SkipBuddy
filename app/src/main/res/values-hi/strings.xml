    <string name="wizard_step_finish_title">बिना परेशानी देखने के लिए तैयार</string>
    <string name="wizard_step_finish_body">अभी फ्लोटिंग बटन को छिपाकर लॉक कर दें ताकि गलती से हाथ लगने पर भी SkipBuddy बंद न हो।</string>
