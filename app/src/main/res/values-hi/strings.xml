    <string name="perm_overlay_title">अन्य ऐप्स के ऊपर दिखाएं</string>
    <string name="perm_overlay_desc">केवल YouTube के लिए फ्लोटिंग बटन और विज्ञापन संदेश दिखाने हेतु।</string>
