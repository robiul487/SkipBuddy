    <!-- Guide Tab -->
    <string name="guide_title">SkipBuddy कैसे काम करता है</string>
    <string name="guide_caregiver_note">आप एक बार SkipBuddy सेटअप करके बटन को छिपाकर लॉक कर दें — आपके पिताजी बस YouTube देखेंगे, उन्हें SkipBuddy छूने की ज़रूरत नहीं।</string>
    <string name="button_reopen_wizard">सेटअप विज़ार्ड खोलें</string>
    <string name="guide_step_1_title">1. Accessibility चालू करें</string>
    <string name="guide_step_1_body">Accessibility सेटिंग्स खोलें, SkipBuddy चुनें और चालू करें।</string>
    <string name="guide_step_2_title">2. YouTube खोलें</string>
    <string name="guide_step_2_body">कोई भी वीडियो पोर्ट्रेट, लैंडस्केप या फुलस्क्रीन में चलाएं।</string>
    <string name="guide_step_3_title">3. विज्ञापन अपने आप स्किप होंगे</string>
    <string name="guide_step_3_body">Skip Ad बटन दिखते ही SkipBuddy उसे दबाएगा और बिना-स्किप विज्ञापन म्यूट रखेगा।</string>

