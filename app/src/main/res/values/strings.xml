    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Finds and taps Skip Ad inside YouTube and YouTube Music only.</string>
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Shows the optional floating button and ad banner in YouTube and YouTube Music.</string>
    <string name="perm_battery_title">Battery Optimization</string>
    <string name="perm_battery_desc">Stops Android from turning off SkipBuddy in the background.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_desc">Quiet reminder after phone restart if SkipBuddy is off.</string>

    <!-- Android 13+ Restricted Setting Help -->
    <string name="restricted_setting_title">If Android shows \"Restricted setting\"</string>
    <string name="restricted_setting_body">Some phones (Android 13 and newer) may block this once for sideloaded apps:\n1) Open Settings &gt; Apps &gt; SkipBuddy.\n2) Tap the three-dot menu (top right) &gt; Allow restricted settings, and confirm with your PIN/fingerprint.\n3) Come back to Accessibility and turn SkipBuddy ON.</string>
    <string name="button_open_app_settings">Open App Settings</string>

    <!-- Setup Wizard -->
    <string name="wizard_title">SkipBuddy Setup</string>
    <string name="wizard_step_counter">Step %1$d of %2$d</string>
    <string name="wizard_skip">Skip Setup</string>
    <string name="wizard_back">Back</string>
    <string name="wizard_next">Next</string>
    <string name="wizard_finish">Finish</string>

    <string name="wizard_step_accessibility_title">Turn On Accessibility Service</string>
    <string name="wizard_step_accessibility_body">This is required so SkipBuddy can detect ads and tap Skip Ad inside YouTube and YouTube Music.</string>
    <string name="wizard_step_overlay_title">Allow Display Over Other Apps</string>
    <string name="wizard_step_overlay_body">Allows the floating indicator and on-screen ad wait banner in YouTube and YouTube Music.</string>
    <string name="wizard_step_battery_title">Disable Battery Optimization</string>
    <string name="wizard_step_battery_body">Keeps SkipBuddy running quietly in the background without being stopped.</string>
    <string name="wizard_step_notifications_title">Allow Quiet Notifications</string>
    <string name="wizard_step_notifications_body">Lets SkipBuddy remind you after a phone restart if the service is off.</string>
    <string name="wizard_step_autostart_title">Xiaomi &amp; Samsung Autostart Guide</string>
    <string name="wizard_step_autostart_xiaomi">Xiaomi / Redmi / POCO (MIUI / HyperOS):\nOpen App Info → Turn ON Autostart → Battery saver → Choose \"No restrictions\".</string>
    <string name="wizard_step_autostart_samsung">Samsung (One UI):\nOpen App Info → Battery → Choose \"Unrestricted\" → Settings → Battery → Background usage limits → Add SkipBuddy to \"Never auto sleeping apps\".</string>
    <string name="wizard_open_app_info">Open App Settings</string>
    <string name="wizard_step_sound_title">Test Voice Announcement</string>
    <string name="wizard_step_sound_body">Play the bundled announcement voice that plays while an unskippable ad is muted.</string>
    <string name="wizard_step_finish_title">Ready for Hands-Off Watching</string>
    <string name="wizard_step_finish_body">Hide and lock the floating button now so accidental touches can never pause SkipBuddy while watching YouTube.</string>
    <string name="wizard_button_hide_and_lock">Hide &amp; Lock Button (Recommended)</string>
    <string name="wizard_button_keep_autohide">Keep Auto-Hide &amp; Lock</string>

