    <!-- Guide Tab -->
    <string name="guide_title">How SkipBuddy Works</string>
    <string name="guide_caregiver_note">You set SkipBuddy up once, then hide and lock the button — your father just uses YouTube and YouTube Music, he never needs to touch SkipBuddy.</string>
    <string name="button_reopen_wizard">Open Setup Wizard</string>
    <string name="guide_step_1_title">1. Enable Accessibility</string>
    <string name="guide_step_1_body">Open Accessibility Settings, find SkipBuddy, and turn it ON.</string>
    <string name="guide_step_2_title">2. Open YouTube and YouTube Music</string>
    <string name="guide_step_2_body">Play any video or music in YouTube and YouTube Music — in portrait, landscape, or fullscreen.</string>
    <string name="guide_step_3_title">3. Ads Skip Automatically</string>
    <string name="guide_step_3_body">SkipBuddy taps Skip Ad automatically and mutes unskippable ads.</string>

